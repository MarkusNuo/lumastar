{
  "components": {
    "schemas": {
      "AuthStatusResponse": {
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "displayName": {
            "description": "Only present when authenticated",
            "type": "string"
          },
          "setupRequired": {
            "description": "No account exists yet; the app shows the first-start setup",
            "type": "boolean"
          }
        },
        "required": [
          "authenticated",
          "setupRequired"
        ],
        "type": "object"
      },
      "Level": {
        "enum": [
          "A0",
          "A1.1",
          "A1.2",
          "A1.3",
          "A2.1",
          "A2.2",
          "A2.3",
          "B1.1",
          "B1.2",
          "B1.3",
          "B2.1",
          "B2.2",
          "B2.3",
          "C1.1",
          "C1.2",
          "C1.3",
          "C2.1",
          "C2.2",
          "C2.3"
        ],
        "type": "string"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "description": "RFC 9457 problem details",
        "properties": {
          "code": {
            "description": "Stable, machine-readable error code, e.g. invalid_credentials",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "description": "Invalid fields (code validation_failed)",
            "items": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "retryAfterSeconds": {
            "description": "Seconds until the next login attempt (code login_throttled)",
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code",
          "status",
          "title"
        ],
        "type": "object"
      },
      "ProfileResponse": {
        "properties": {
          "currentLevel": {
            "$ref": "#/components/schemas/Level",
            "description": "Absent until the placement test (or its skip) has set a level"
          },
          "dailyGoalMinutes": {
            "description": "5, 10, 15 or 20",
            "format": "int32",
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "onboardingCompleted": {
            "type": "boolean"
          },
          "xpTotal": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "dailyGoalMinutes",
          "displayName",
          "onboardingCompleted",
          "xpTotal"
        ],
        "type": "object"
      },
      "SetupRequest": {
        "description": "Creates the only account of this instance.",
        "properties": {
          "displayName": {
            "description": "Name shown in the app",
            "example": "Erza",
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "description": "Protects the instance; at least 8 characters",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "password"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "csrfHeader": {
        "description": "Value of the XSRF-TOKEN cookie; required on POST, PUT, PATCH and DELETE",
        "in": "header",
        "name": "X-XSRF-TOKEN",
        "type": "apiKey"
      },
      "sessionCookie": {
        "description": "httpOnly session cookie set by setup and login",
        "in": "cookie",
        "name": "LINGORA_SESSION",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Backend of Lingora, the adaptive Gheg Albanian learning app. Errors are RFC 9457 problem details with a machine-readable `code`.",
    "title": "Lingora API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in; the session cookie is set"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Wrong password"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Missing or invalid CSRF token"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too many failed attempts; see the Retry-After header"
          }
        },
        "security": [
          {
            "csrfHeader": []
          }
        ],
        "summary": "Sign in with the password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Missing or invalid CSRF token"
          }
        },
        "security": [
          {
            "csrfHeader": [],
            "sessionCookie": []
          }
        ],
        "summary": "Sign out and end the session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/setup": {
      "post": {
        "operationId": "setupAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "Account created; the session cookie is set"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid display name or password"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Missing or invalid CSRF token"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "An account already exists"
          }
        },
        "security": [
          {
            "csrfHeader": []
          }
        ],
        "summary": "Create the only account of this instance and sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/status": {
      "get": {
        "description": "Public. Also issues the XSRF-TOKEN cookie that unsafe requests must echo in X-XSRF-TOKEN.",
        "operationId": "getAuthStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Whether setup is required and whether the caller is signed in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "The profile"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "Basic profile of the signed-in learner",
        "tags": [
          "profile"
        ]
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "servers": [
    {
      "description": "Same origin as the web app",
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "First-start setup, sign-in and sign-out of the single account",
      "name": "auth"
    },
    {
      "description": "The signed-in learner",
      "name": "profile"
    }
  ]
}
