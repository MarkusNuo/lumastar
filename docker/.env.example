# Copy to docker/.env and fill in. The real file holds secrets and is never committed.

# Domain the site is served on (Caddy fetches the TLS certificate) and the URL used in mail links
LUMASTAR_SITE_ADDRESS=lumastar.example.com
LUMASTAR_PUBLIC_URL=https://lumastar.example.com

LUMASTAR_DB_PASSWORD=change-me

# open | invite | closed
LUMASTAR_REGISTRATION_MODE=invite
LUMASTAR_REGISTRATION_INVITE_CODE=change-me

# Web push reminders (optional): generate a key pair with `cd backend && ./gradlew generateVapidKeys`
LUMASTAR_PUSH_PUBLIC_KEY=
LUMASTAR_PUSH_PRIVATE_KEY=
LUMASTAR_PUSH_SUBJECT=mailto:admin@example.com

# Account mails (optional; without them verification and reset mails are not sent)
# LUMASTAR_MAIL_HOST=smtp.example.com
# LUMASTAR_MAIL_PORT=587
# LUMASTAR_MAIL_SMTP_AUTH=true
# LUMASTAR_MAIL_STARTTLS=true
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# LUMASTAR_MAIL_FROM=Lumastar <noreply@example.com>
