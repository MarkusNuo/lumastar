{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingora.invalid/schema/placement.schema.json",
  "title": "Lingora placement item bank",
  "description": "content/placement.json: auto-evaluable placement exercises across all levels (docs/CONTENT_FORMAT.md).",
  "type": "object",
  "required": ["schemaVersion", "exercises"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/exercise",
        "type": "object",
        "required": ["competence"],
        "properties": {
          "id": { "type": "string", "pattern": "^pl_[a-z0-9_]+_\\d{3}$" },
          "competence": { "$ref": "common.schema.json#/$defs/competence" },
          "type": { "enum": ["multiple_choice", "fill_gap", "translate_wordbank", "word_order", "translate_free"] }
        }
      }
    }
  }
}
