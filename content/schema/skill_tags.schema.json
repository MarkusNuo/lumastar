{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumastar.invalid/schema/skill_tags.schema.json",
  "title": "Lumastar skill tag registry",
  "description": "content/skill_tags.json: every skill tag used in curriculum, units and placement (docs/CONTENT_FORMAT.md).",
  "type": "object",
  "required": ["schemaVersion", "tags"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "area"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/skillTagId" },
          "label": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "area": { "enum": ["vocab", "phrase", "grammar", "spelling", "reading"] }
        }
      }
    }
  }
}
