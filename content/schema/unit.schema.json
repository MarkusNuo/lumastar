{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingora.invalid/schema/unit.schema.json",
  "title": "Lingora unit",
  "description": "content/units/<unitId>.json: items, grammar notes and exercises of one unit (docs/CONTENT_FORMAT.md).",
  "type": "object",
  "required": ["schemaVersion", "unitId", "level", "grammar", "items", "exercises"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "unitId": { "$ref": "common.schema.json#/$defs/unitId" },
    "level": { "$ref": "common.schema.json#/$defs/level" },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "explanation"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "explanation": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    },
    "items": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/item" } },
    "exercises": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/exercise",
        "type": "object",
        "properties": { "id": { "type": "string", "pattern": "^ex_[a-z0-9_]+_\\d{3}$" } }
      }
    }
  }
}
